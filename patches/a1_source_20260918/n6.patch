+static void __LL_LIB_Outputs_Memcpy_End_EpochBlock(const LL_ATON_RT_EpochBlockItem_t *epoch_block,
+                                                   const NN_Instance_TypeDef *nn_instance)
+{
+  LL_ATON_LIB_UNUSED(nn_instance);
