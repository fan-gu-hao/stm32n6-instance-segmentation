+#ifndef NDEBUG
+static float Q_to_floating(int i, int Qm, int Qn)
+{
+  LL_ATON_LIB_UNUSED(Qm);
+  if (Qn >= 0)
+    return ((float)i / (float)((int)1 << Qn));
+  if (Qn < 0)
+    return ((float)i * (float)((int)1 << -Qn));
+  return 0.f;
+}
