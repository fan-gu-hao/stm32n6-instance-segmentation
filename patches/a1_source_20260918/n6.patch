+  /**
+   *  @brief enumerator type identifying buffer group (in,out,internal) for dump_xxx functions
+   */
+  enum
+  {
+    BUFF_OUT = 1,
+    BUFF_IN = 2,
+    BUFF_INT = 4,
+  };
