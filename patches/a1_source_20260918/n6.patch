-  t = ATON_CONVACC_DFORMAT_SET_ORNDMODE(t, (conf->relu_mode_o << 1) | conf->round_mode_o);
-  t = ATON_CONVACC_DFORMAT_SET_OBYTES(t, conf->outbytes_o);
