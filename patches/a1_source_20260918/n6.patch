+#if ATON_STRENG_NUM > 2
+  ASSERT_ATONN_SRCPORT(STRSWITCH, 0, STRENG, 2, 0);
+  ASSERT_ATONN_DSTPORT(STRSWITCH, 0, STRENG, 2, 0);
