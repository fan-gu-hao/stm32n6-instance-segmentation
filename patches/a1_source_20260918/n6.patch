+    const NN_Interface_TypeDef *nn_i_ptr = context_ptr->network_instance.network;
+    if (!nn_i_ptr)
+    {
+      __LL_ATON_STAI_SET_1ST_CTX_ERROR_AND_RETURN(context_ptr, STAI_ERROR_NETWORK_INVALID_CONTEXT_HANDLE);
+    }
