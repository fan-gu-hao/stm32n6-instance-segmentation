+      AI_TENSOR_LIST_OBJ_EMPTY)
+  AI_LAYER_OBJ_DECLARE(concat_layer, 1, CONCAT_TYPE, 0x0, NULL, concat, forward_concat, &concat_chain, NULL, NULL, ,
+                       .axis = sw_info->concat_axis)
+  concat_layer.forward(AI_LAYER_OBJ(&concat_layer));
+}
