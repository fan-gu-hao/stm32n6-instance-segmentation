-int LL_Dbgtrc_SynchronousCountersTest(void)
-{
-  int counter;
-  LL_Dbgtrc_Counter_InitTypdef dbgtrc_init = {.evt_type = ATON_DEBUG_TRACE_EVENT_TYPE_LEVEL_HIGH,
-                                              .signal = ATON_DEBUG_TRACE_0_MON_SIG_VDD};
