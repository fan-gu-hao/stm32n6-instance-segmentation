+#if defined(AI_RELOC_LOG_ENABLE) && (AI_RELOC_LOG_ENABLE == 1) && !defined(NDEBUG)
+static char *_magic_to_str(uint32_t val)
+{
+  static char res[5];
+  res[3] = val >> 24;
+  res[2] = val >> 16;
+  res[1] = val >> 8;
+  res[0] = val >> 0;
+  return res;
+}
