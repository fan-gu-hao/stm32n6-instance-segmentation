+  LL_ATON_ASSERT(ATONN_CONST_DSTPORT(S, J, U, I, P) == __atonn_getDstPortID(S, J, U, I, P))
+
+#if ATON_STRENG_NUM > 1
+  ASSERT_ATONN_SRCPORT(STRSWITCH, 0, STRENG, 1, 0);
+  ASSERT_ATONN_DSTPORT(STRSWITCH, 0, STRENG, 1, 0);
