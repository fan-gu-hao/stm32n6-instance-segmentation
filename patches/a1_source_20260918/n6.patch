-      .signal = ATON_DEBUG_TRACE_0_MON_SIG_INT_INTCTRL_0_0 + unitirq,
-      .evt_type = ATON_DEBUG_TRACE_EVENT_TYPE_POSITIVE_EDGE,
-  };
-
-  LL_Dbgtrc_Init(0);
-  LL_Dbgtrc_Counter_Init(0, counter, &dbgtrc_init);
-  LL_Dbgtrc_Counter_Start(0, counter);
-
-  return 0;
