+static void __dump_epoch_buffers(const LL_Buffer_InfoTypeDef *bufs, int mode, int epoch)
+{
+  while (bufs != NULL && bufs[0].name != NULL)
+  {
+    if (epoch == -1 || bufs[0].epoch == epoch)
+    {
+      __dump_buffer(mode, bufs);
+    }
+    bufs++;
+  }
+}
