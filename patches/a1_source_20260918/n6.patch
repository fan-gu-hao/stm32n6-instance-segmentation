+  STAI_INTERNAL_ENTRY
+  static inline stai_return_code __ll_aton_stai_check_context_network_handle(stai_network *network,
+                                                                             const NN_Interface_TypeDef **nn_i_ptr_ptr)
+  {
+    /* check context handle */
+    if (!network)
