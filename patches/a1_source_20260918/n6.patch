-  static inline void LL_ATON_Cache_MCU_Clean_Range(uintptr_t virtual_addr, uint32_t size)
-  {
-    LL_ATON_OSAL_LOCK_MCU_CACHE();
-    mcu_cache_clean_range(virtual_addr, virtual_addr + size);
-    LL_ATON_OSAL_UNLOCK_MCU_CACHE();
-  }
