+#define LL_ATON_DISABLE_ALL_IRQs()                                                                                     \
+  do                                                                                                                   \
+  {                                                                                                                    \
+    LL_ATON_OSAL_DISABLE_IRQ(0);                                                                                       \
+    LL_ATON_OSAL_DISABLE_IRQ(1);                                                                                       \
+    LL_ATON_OSAL_DISABLE_IRQ(2);                                                                                       \
+    LL_ATON_OSAL_DISABLE_IRQ(3);                                                                                       \
+  } while (0)
