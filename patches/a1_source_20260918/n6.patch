+#ifndef LL_ATON_OSAL_UNLOCK_MCU_CACHE
+#define LL_ATON_OSAL_UNLOCK_MCU_CACHE()
+#endif // !LL_ATON_OSAL_UNLOCK_MCU_CACHE
+
+#endif // __LL_ATON_OSAL_H
