+/*** Helper Functions ***/
+
+#ifndef NDEBUG
+static uint32_t __LL_ATON_RT_CntEpochBlocks(const LL_ATON_RT_EpochBlockItem_t *list)
+{
+  int i = 0;
+
+  if (list != NULL)
+  {
+    for (i = 1; !EpochBlock_IsLastEpochBlock(list); i++)
+    { // Note: also terminating empty epoch block is counted
+      list++;
+    }
+  }
+
+  return i;
+}
+#endif
