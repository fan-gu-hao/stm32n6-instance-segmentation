+    __set_all_buffers(nn_interface->input_buffers_info(), val);
+  if ((in & BUFF_OUT) != 0)
+    __set_all_buffers(nn_interface->output_buffers_info(), val);
+  if ((in & BUFF_INT) != 0)
+    __set_all_buffers(nn_interface->internal_buffers_info(), val);
+}
