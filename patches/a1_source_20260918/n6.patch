-/**
- * @brief  Trigger Epoch Controller Single Step execution
- * @param  id Epoch Controller identifier [0..ATON_EPOCHCTRL_NUM-1]
- * @retval Error code
- */
-int LL_EpochCtrl_Step(int id)
-{
-  uint32_t t;
