+    MODE_RAW_INBITS = MODE_RAW | MODE_INBITS,
+    MODE_ONNX_INBITS = MODE_ONNX | MODE_INBITS,
+    MODE_RAW_INFLOAT = MODE_RAW | MODE_INFLOAT,
+    MODE_ONNX_INFLOAT = MODE_ONNX | MODE_INFLOAT,
