+#define _CreateWfeSemaphore_(_dao_obj, _dao_static_buffer)      tx_semaphore_create(&(_dao_obj), TX_NULL, 0)
+#define _CreateCacheMutex_(_dao_obj, _dao_static_buffer)        tx_mutex_create(&(_dao_obj), TX_NULL, TX_INHERIT)
