+/* Set context error */
+#define __LL_ATON_STAI_SET_1ST_CTX_ERROR_AND_RETURN(ctx, err)                                                          \
+  do                                                                                                                   \
+  {                                                                                                                    \
+    /* check context handle */                                                                                         \
+    if (!(ctx))                                                                                                        \
+      return STAI_ERROR_NETWORK_INVALID_CONTEXT_HANDLE;                                                                \
+                                                                                                                       \
+    if (((ctx)->first_error) < STAI_ERROR_GENERIC)                                                                     \
+      (ctx)->first_error = (err);                                                                                      \
+    return (err);                                                                                                      \
+  } while (0)
+
