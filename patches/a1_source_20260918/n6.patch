-      // LL_ATON_PRINTF("q2f nbits=%d 16: out=%p in=%p in_el=%d\n", input->nbits, out, in, in_elements);
-      for (i = 0; i < in_elements; i++)
-      {
-        int t = (int)*in;
-        float f = in_scaleoffset ? __scale_offset_to_floating(t, Qm_in, Qn_in, in_scale, in_offset)
