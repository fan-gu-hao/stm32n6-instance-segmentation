-  nn_instance->exec_state.nr_of_epoch_blocks = __LL_ATON_RT_CntEpochBlocks(nn_instance->exec_state.current_epoch_block);
-  nn_instance->exec_state.saved_nr_of_epoch_blocks = 0;
